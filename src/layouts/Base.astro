---
import '../styles/site.css';
import { SITE } from '../data/site';
import { getVisitors, seoulTime } from '../lib/visitors';

interface Props {
	title?: string;
	description?: string;
	current?: 'latest' | 'series' | 'topics' | 'bugs' | 'about';
	/** Set on a post: turns the page into an article for search engines */
	published?: Date;
	modified?: Date;
}

const { title, description = SITE.description, current, published, modified } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} | ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const author = { '@type': 'Person', name: 'TeddyBEARs56', url: SITE.github };
// Structured data so search engines know which page is the blog and which is a post
const jsonLd = published
	? {
			'@context': 'https://schema.org',
			'@type': 'BlogPosting',
			headline: title,
			description,
			datePublished: published.toISOString(),
			dateModified: (modified ?? published).toISOString(),
			inLanguage: 'ko',
			url: canonical.href,
			mainEntityOfPage: canonical.href,
			author,
			isPartOf: { '@type': 'Blog', name: SITE.title, url: Astro.site?.href },
		}
	: { '@context': 'https://schema.org', '@type': 'Blog', name: SITE.title, description, inLanguage: 'ko', url: canonical.href, author };
const nav = [
	{ key: 'latest', href: '/#latest', label: '최신 글' },
	{ key: 'series', href: '/#series', label: '연재' },
	{ key: 'topics', href: '/#topics', label: '주제별' },
	{ key: 'bugs', href: '/bugs/', label: 'Cybug' },
	{ key: 'about', href: '/#about', label: '소개' },
] as const;
const visitors = await getVisitors();
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate" type="application/rss+xml" title={SITE.title} href={new URL('rss.xml', Astro.site)} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta property="og:type" content={published ? 'article' : 'website'} />
		<meta property="og:site_name" content={SITE.title} />
		<meta property="og:locale" content="ko_KR" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		{published && <meta property="article:published_time" content={published.toISOString()} />}
		<meta name="robots" content="index, follow" />
		{SITE.googleSiteVerification && <meta name="google-site-verification" content={SITE.googleSiteVerification} />}
		<meta name="generator" content={Astro.generator} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Host+Grotesk:wght@400;500&family=Atkinson+Hyperlegible+Mono:wght@400;500&display=swap" />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
		<script is:inline>
			document.documentElement.classList.add('js');
			// iOS Safari applies :active only when a touch listener exists (the name shows Cyblog while pressed)
			document.addEventListener('touchstart', function () {}, { passive: true });
		</script>
		<style is:global>
			html, body { overflow-x: clip; }
		</style>
		{SITE.gaMeasurementId && (
			<>
				<script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaMeasurementId}`}></script>
				<script is:inline define:vars={{ gaId: SITE.gaMeasurementId }}>
					window.dataLayer = window.dataLayer || [];
					function gtag() { dataLayer.push(arguments); }
					gtag('js', new Date());
					gtag('config', gaId);
				</script>
			</>
		)}
	</head>
	<body>
		<a class="skip" href="#main">본문으로 건너뛰기</a>

		<header class="site-header">
			<div class="container site-header__inner">
				<a class="wordmark wordmark--diff" href="/" aria-label={`${SITE.title} 처음으로`}><span aria-hidden="true">Cyb<span class="wm__org">org</span><span class="wm__log">log</span></span></a>
				<nav class="site-nav" aria-label="주 메뉴">
					<ul>
						{nav.map((item) => (
							<li class:list={{ 'site-nav__wide': item.key === 'latest' }}><a href={item.href} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a></li>
						))}
					</ul>
				</nav>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container site-footer__inner">
				<div class="site-footer__mark">
					<a class="wordmark" href="/">{SITE.title}</a>
					{visitors && (
						<div class="visits">
							<dl aria-label="방문자">
								<div><dt>오늘</dt><dd class="measured">{visitors.today.toLocaleString('ko-KR')}</dd></div>
								<div><dt>전체</dt><dd class="measured">{visitors.total.toLocaleString('ko-KR')}</dd></div>
							</dl>
							<p>구글 애널리틱스 기준, <time class="measured" datetime={visitors.at.toISOString()}>{seoulTime(visitors.at)}</time>에 셈. 한 시간마다 고칩니다.</p>
						</div>
					)}
				</div>
				<ul class="site-footer__links">
					<li><a href="/#series">연재 목차</a></li>
					<li><a href="/bugs/">Cybug</a></li>
					<li><a href="/rss.xml">RSS</a></li>
					<li><a href={SITE.github}>GitHub</a></li>
				</ul>
				<p class="site-footer__legal">© 2026 {SITE.title}. 글꼴은 Pretendard, Host Grotesk, Atkinson Hyperlegible Mono.</p>
			</div>
		</footer>
	</body>
</html>
